# Vendor driver binaries and import libraries.
# Keep these out of public repositories unless the vendor license allows redistribution.
ControlCANx64/**/*.dll
ControlCANx64/**/*.lib
ControlCANx64/**/*.exe
library/**/*.dll
library/**/*.lib
library/**/*.exe
